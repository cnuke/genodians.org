<config>

	<parent-provides>
		<service name="ROM"/>
		<service name="PD"/>
		<service name="RM"/>
		<service name="CPU"/>
		<service name="LOG"/>
		<service name="Nic"/>
		<service name="Timer"/>
		<service name="Rtc"/>
	</parent-provides>

	<default-route> <any-service> <parent/> </any-service> </default-route>

	<default caps="100"/>

	<service name="Uplink">
		<default-policy> <child name="nic_router"/> </default-policy> </service>

	<start name="webroot_fs" caps="200">
		<binary name="vfs"/>
		<resource name="RAM" quantum="4M"/>
		<provides> <service name="File_system"/> </provides>
		<config>
			<vfs> <ram/> </vfs>
			<policy label_prefix="uacme-env -> token" root="/" writeable="yes"/>
			<policy label_prefix="lighttpd"           root="/"/>
		</config>
	</start>

	<start name="account_fs" caps="200">
		<binary name="vfs"/>
		<resource name="RAM" quantum="8M"/>
		<provides> <service name="File_system"/> </provides>
		<config>
			<vfs> <ram/> </vfs>
			<policy label_prefix="uacme-env -> account"     root="/" writeable="yes"/>
			<policy label_prefix="uacme-env -> certificate" root="/" writeable="yes"/>
		</config>
	</start>

	<start name="uacme-env" caps="3500">
		<binary name="sequence"/>
		<resource name="RAM" quantum="120M"/>
		<route>
			<service name="ROM" label="config">                   <parent label="uacme-env.config"/> </service>
                        <service name="ROM" label="create_account -> config"> <parent label="create_account.config"/> </service>

			<service name="File_system" label="account"> <child name="webroot_fs" label="account"/> </service>
			<service name="File_system" label="token">   <child name="webroot_fs" label="token"/> </service>

			<service name="CPU">   <parent/> </service>
			<service name="LOG">   <parent/> </service>
			<service name="PD">    <parent/> </service>
			<service name="RM">    <parent/> </service>
			<service name="ROM">   <parent/> </service>
			<service name="Rtc">   <parent/> </service>
			<service name="Timer"> <parent/> </service>
		</route>
	</start>

	<start name="nic_router" caps="120">
		<resource name="RAM" quantum="10M"/>
		<provides>
			<service name="Nic"/>
			<service name="Uplink"/>
		</provides>
		<route>
			<service name="ROM" label="config">
				<parent label="nic_router.config"/>
			</service>
			<service name="Timer"> <parent/> </service>
			<service name="Nic"> <parent/> </service>
			<service name="LOG"> <parent/> </service>
			<service name="PD">  <parent/> </service>
			<service name="CPU"> <parent/> </service>
			<service name="ROM"> <parent/> </service>
		</route>
	</start>

	<start name="lighttpd" caps="200">
		<resource name="RAM" quantum="64M" />
		<config ld_verbose="yes">
			<arg value="lighttpd" />
			<arg value="-f"/>
			<arg value="/etc/lighttpd/lighttpd.conf" />
			<arg value="-D"/>
			<vfs>
				<dir name="dev">
					<log/>
					<null/>
					<rtc/>
					<jitterentropy name="random"/>
				</dir>
				<dir name="socket">
					<lxip dhcp="yes"/> </dir>
				<dir name="etc">
					<dir name="lighttpd">
						<rom name="lighttpd.conf" binary="no"/>
					</dir>
				</dir>
				<dir name="webroot">
					<fs/>
				</dir>
			</vfs>
			<libc stdin="/dev/null" stdout="/dev/log" stderr="/dev/log"
			      socket="/socket" rtc="/dev/rtc"/>
		</config>
		<route>
			<service name="Nic">         <child name="nic_router"/> </service>
			<service name="File_system"> <child name="webroot_fs"/> </service>
			<service name="CPU">   <parent/> </service>
			<service name="LOG">   <parent/> </service>
			<service name="PD">    <parent/> </service>
			<service name="RM">    <parent/> </service>
			<service name="ROM">   <parent/> </service>
			<service name="Rtc">   <parent/> </service>
			<service name="Timer"> <parent/> </service>
		</route>
	</start>

</config>
